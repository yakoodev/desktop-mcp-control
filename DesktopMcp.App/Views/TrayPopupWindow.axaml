<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:DesktopMcp.App.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        d:DesignWidth="300"
        d:DesignHeight="224"
        x:Class="DesktopMcp.App.Views.TrayPopupWindow"
        Classes="GlassWindow"
        x:DataType="vm:MainWindowViewModel"
        Width="300"
        Height="224"
        Icon="/Assets/icon.png"
        CanResize="False"
        ShowInTaskbar="False"
        WindowDecorations="None"
        ExtendClientAreaToDecorationsHint="True"
        CornerRadius="13"
        TransparencyLevelHint="Transparent"
        Topmost="True"
        WindowStartupLocation="Manual"
        Background="{x:Null}"
        Title="Desktop MCP Tray">

  <Window.Styles>
    <Style Selector="TextBlock.trayIcon">
      <Setter Property="FontFamily" Value="Segoe MDL2 Assets" />
      <Setter Property="FontSize" Value="15" />
      <Setter Property="Foreground" Value="#C5D3E9" />
      <Setter Property="HorizontalAlignment" Value="Center" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style Selector="Button.menuRow">
      <Setter Property="Height" Value="36" />
      <Setter Property="Padding" Value="9,0" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="CornerRadius" Value="8" />
    </Style>

    <Style Selector="Button.menuRow:pointerover">
      <Setter Property="Background" Value="#7B273B5D" />
    </Style>

    <Style Selector="TextBlock.menuText">
      <Setter Property="Foreground" Value="#F0F5FF" />
      <Setter Property="FontSize" Value="13" />
    </Style>

    <Style Selector="TextBlock.menuSub">
      <Setter Property="Foreground" Value="#8D9CBA" />
      <Setter Property="FontSize" Value="11" />
    </Style>
  </Window.Styles>

  <Grid>
    <Border
            CornerRadius="13"
            BorderThickness="1"
            BorderBrush="#667B91AC"

            ClipToBounds="True">
      <Border.Background>
        <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
          <GradientStop Color="#AE223147" Offset="0" />
          <GradientStop Color="#B2161F31" Offset="0.56" />
          <GradientStop Color="#B80B111D" Offset="1" />
        </LinearGradientBrush>
      </Border.Background>

      <Grid RowDefinitions="40,1,36,36,36,1,36" Margin="12">
        <Grid Grid.Row="0" ColumnDefinitions="28,*,Auto" Background="{x:Null}" PointerPressed="TitleBar_OnPointerPressed">
          <Border Width="22" Height="22" CornerRadius="11" Background="#273A58" HorizontalAlignment="Center" VerticalAlignment="Center">
            <Image Source="/Assets/icon.png" Width="20" Height="20" HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <TextBlock Grid.Column="1" Text="Desktop MCP" Foreground="#F0F5FF" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" />
          <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
            <TextBlock Text="●" Foreground="#63DE88" FontSize="10" VerticalAlignment="Center" />
            <TextBlock Text="{Binding StatusText}" Foreground="#69DF8E" FontSize="12" />
          </StackPanel>
        </Grid>

        <Border Grid.Row="1" Height="1" Background="#5E6F8780" />

        <Button Grid.Row="2" Classes="menuRow" Command="{Binding OpenControlPanelCommand}">
          <Grid ColumnDefinitions="30,*">
            <TextBlock Classes="trayIcon" Text="&#xE8A7;" />
            <TextBlock Grid.Column="1" Classes="menuText" Text="Open Control Panel" VerticalAlignment="Center" />
          </Grid>
        </Button>

        <Button Grid.Row="3" Classes="menuRow" Command="{Binding OpenToolsCommand}">
          <Grid ColumnDefinitions="30,*">
            <TextBlock Classes="trayIcon" Text="&#xE7B8;" />
            <TextBlock Grid.Column="1" Classes="menuText" Text="Available Tools" VerticalAlignment="Center" />
          </Grid>
        </Button>

        <Button Grid.Row="4" Classes="menuRow" Command="{Binding OpenSettingsCommand}">
          <Grid ColumnDefinitions="30,*">
            <TextBlock Classes="trayIcon" Text="&#xE713;" />
            <TextBlock Grid.Column="1" Classes="menuText" Text="Settings" VerticalAlignment="Center" />
          </Grid>
        </Button>

        <Border Grid.Row="5" Height="1" Background="#5E6F8780" />

        <Button Grid.Row="6" Classes="menuRow" Command="{Binding ExitApplicationCommand}">
          <Grid ColumnDefinitions="30,*,Auto">
            <TextBlock Classes="trayIcon" Text="&#xE8BB;" Foreground="#FF6363" />
            <TextBlock Grid.Column="1" Text="Exit" Foreground="#FF7070" FontSize="13" VerticalAlignment="Center" />
            <TextBlock Grid.Column="2" Classes="menuSub" Text="Alt+F4" VerticalAlignment="Center" />
          </Grid>
        </Button>
      </Grid>
    </Border>
  </Grid>
</Window>








